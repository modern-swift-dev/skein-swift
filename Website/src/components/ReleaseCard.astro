---
import type { Release } from "../lib/release";
interface Props { release: Release; }
const { release } = Astro.props;
const date = new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(release.publishedAt);
const installVersion = release.version.startsWith("v") ? release.version.slice(1) : release.version;
---

<section class="surface overflow-hidden" aria-labelledby="release-title">
  <div class="bg-gradient-to-r from-indigo-700 to-violet-600 px-6 py-5 text-white">
    <p class="text-sm font-medium text-indigo-100">Latest stable release</p>
    <h2 id="release-title" class="mt-1 text-2xl font-semibold">Skein {release.version}</h2>
    <p class="mt-1 text-sm text-indigo-100">Published {date}</p>
  </div>
  <div class="p-6">
    <p class="text-sm text-muted">Use this version when adding Skein with Swift Package Manager.</p>
    <code class="mt-4 block overflow-x-auto rounded-xl bg-indigo-50 px-4 py-3 text-sm text-indigo-950">.package(url: "https://github.com/modern-swift-dev/skein-swift.git", from: "{installVersion}")</code>
    {release.notes && <p class="mt-5 whitespace-pre-line text-sm leading-6 text-muted">{release.notes}</p>}
    <a class="mt-5 inline-block font-semibold text-indigo-ink" href={release.url}>Read release notes ↗</a>
  </div>
</section>
