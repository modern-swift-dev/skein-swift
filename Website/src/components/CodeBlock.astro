---
interface Props { code: string; language?: string; title?: string; }
const { code, language = "swift", title } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 shadow-xl shadow-indigo-950/15">
  {title && <div class="border-b border-slate-800 px-5 py-3 text-xs font-medium text-slate-400">{title}</div>}
  <pre class="overflow-x-auto p-5 text-sm leading-6 text-slate-100"><code class={`language-${language}`}>{code}</code></pre>
</div>
