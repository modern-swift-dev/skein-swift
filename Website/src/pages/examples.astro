---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { rawRepositoryURL, repositoryURL } from "../lib/links";

interface ExampleSource {
  name: string;
  description: string;
  sourcePath: string;
  command: string;
  code: string;
}

const exampleDefinitions = [
  { name: "BasicUsage", description: "Owned SkeinApplication, lazy singletons, factories, assisted factories, and a typed scope.", sourcePath: "Examples/Sources/BasicUsage/main.swift", command: "swift run --package-path Examples BasicUsage" },
  { name: "ModularComposition", description: "Feature modules and a protocol registration for a live API client.", sourcePath: "Examples/Sources/ModularComposition/main.swift", command: "swift run --package-path Examples ModularComposition" },
  { name: "QualifiedBindings", description: "Multiple values of the same type, separated by qualifiers.", sourcePath: "Examples/Sources/QualifiedBindings/main.swift", command: "swift run --package-path Examples QualifiedBindings" },
  { name: "ErrorHandling", description: "Provider failures wrapped in SkeinResolutionError and retried singletons.", sourcePath: "Examples/Sources/ErrorHandling/main.swift", command: "swift run --package-path Examples ErrorHandling" },
  { name: "MainActorValidation", description: "MainActor bindings, eager roots, and async startup validation.", sourcePath: "Examples/Sources/MainActorValidation/MainActorValidation.swift", command: "swift run --package-path Examples MainActorValidation" },
  { name: "TestingExampleTests", description: "A production module replaced with a hand-written fake in an isolated test container.", sourcePath: "Examples/Tests/TestingExampleTests/TestingExampleTests.swift", command: "swift test --package-path Examples" }
] as const;

const examples: ExampleSource[] = await Promise.all(exampleDefinitions.map(async (definition) => ({
  ...definition,
  code: await readFile(resolve(process.cwd(), "..", definition.sourcePath), "utf8")
})));
---

<BaseLayout title="Skein examples" description="Compile-checked Skein examples from this repository.">
  <section class="border-b border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-violet-50 py-18 md:py-24"><div class="page-shell"><p class="text-sm font-semibold text-indigo-ink">Examples</p><h1 class="mt-3 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Code that this repository compiles.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Each target in <code>Examples</code> uses the local Skein checkout. These blocks are read from the source files at build time, not copied into the site by hand.</p></div></section>
  <section class="page-shell py-16"><div class="space-y-14">{examples.map((example) => <article class="grid gap-6 lg:grid-cols-[.8fr_1.2fr] lg:items-start"><div class="surface p-6"><h2 class="text-2xl font-bold text-ink">{example.name}</h2><p class="mt-3 leading-7 text-muted">{example.description}</p><p class="mt-5 text-sm text-muted">Run: <code>{example.command}</code></p><a class="mt-5 inline-block font-semibold text-indigo-ink" href={`${rawRepositoryURL}/${example.sourcePath}`}>Open source file ↗</a></div><CodeBlock code={example.code} title={example.sourcePath} /></article>)}</div><a class="mt-12 inline-block font-semibold text-indigo-ink" href={`${repositoryURL}/tree/main/Examples`}>Browse all examples ↗</a></section>
</BaseLayout>
