{"variants":[{"paths":["\/documentation\/skein\/modulesandprotocolbindings"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index"}],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/ModulesAndProtocolBindings","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Skein"}],"roleHeading":"Article","role":"article","title":"Modules and protocol bindings"},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/Skein\/documentation\/Skein\/GettingStarted","doc:\/\/Skein\/documentation\/Skein\/BindingsAndLifetimes","doc:\/\/Skein\/documentation\/Skein\/Qualifiers"],"generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Modules keep registrations close to the feature that owns them. Application builders accept individual modules, arrays, optionals, conditions, and loops directly.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Skein","","protocol HTTPClient {","    func get(path: String) throws -> String","}","","final class URLSessionClient: HTTPClient {","    func get(path: String) throws -> String { \"response\" }","}","","final class ArticleRepository {","    private let client: any HTTPClient","","    init(client: any HTTPClient) {","        self.client = client","    }","}","","let networking = module {","    single((any HTTPClient).self, provider: { _ in URLSessionClient() })","}","","let articles = module {","    factory(ArticleRepository.self, using: ArticleRepository.init)","}","","try startSkein {","    networking","    articles","}"]},{"type":"paragraph","inlineContent":[{"text":"The binding key is the declared type, not the concrete type returned by the provider. Register a protocol existential such as ","type":"text"},{"type":"codeVoice","code":"(any HTTPClient).self"},{"text":" when consumers depend on the protocol. Resolve the same declared type inside providers and at call sites.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let client = try get((any HTTPClient).self)","let repository: ArticleRepository = try get()"]},{"type":"paragraph","inlineContent":[{"text":"All modules are collected during application creation. Registering the same type and qualifier twice, whether in one module or separate modules, fails creation with a source-aware ","type":"text"},{"type":"codeVoice","code":"SkeinConfigurationError"},{"text":" whose ","type":"text"},{"type":"codeVoice","code":"underlying"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"SkeinError.duplicateBinding"},{"text":". Use ","type":"text"},{"identifier":"doc:\/\/Skein\/documentation\/Skein\/Qualifiers","type":"reference","isActive":true},{"text":" when multiple implementations of one type are intentional.","type":"text"}]},{"type":"heading","level":2,"text":"Test or environment overlays","anchor":"Test-or-environment-overlays"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"overriding(_:)"},{"text":" creates a reusable module where registrations in the overlay replace exact binding keys from the base module. Duplicates within either input module still fail when an application is created.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let production = module {","    single((any HTTPClient).self, provider: { _ in URLSessionClient() })","}","final class PreviewHTTPClient: HTTPClient {","    func get(path: String) throws -> String { \"preview\" }","}","let preview = module {","    single((any HTTPClient).self, provider: { _ in PreviewHTTPClient() })","}","","let previewApplication = try SkeinApplication {","    production.overriding(preview)","}"]}],"kind":"content"}],"references":{"doc://Skein/documentation/Skein/Qualifiers":{"type":"topic","title":"Qualifiers","kind":"article","abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index"}],"role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/Qualifiers","url":"\/documentation\/skein\/qualifiers"},"doc://Skein/documentation/Skein/BindingsAndLifetimes":{"type":"topic","title":"Bindings and lifetimes","kind":"article","abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index"}],"role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/BindingsAndLifetimes","url":"\/documentation\/skein\/bindingsandlifetimes"},"doc://Skein/documentation/Skein/GettingStarted":{"type":"topic","title":"Getting started","kind":"article","abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index"}],"role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/GettingStarted","url":"\/documentation\/skein\/gettingstarted"},"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","identifier":"doc:\/\/Skein\/documentation\/Skein","title":"Skein","role":"collection","type":"topic","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"kind":"symbol"}}}