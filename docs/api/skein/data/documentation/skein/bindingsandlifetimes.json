place their runtime argument first and also use "},{"code":"using:","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Isolation","type":"heading","text":"Isolation"},{"inlineContent":[{"type":"text","text":"Unprefixed bindings and "},{"code":"get","type":"codeVoice"},{"type":"text","text":" are MainActor-isolated by default. Services do not need to conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@MainActor final class ScreenCoordinator {","    init(configuration: AppConfiguration) { }","}","","let presentation = module {","    instance(AppConfiguration())","    single(ScreenCoordinator.self, using: ScreenCoordinator.init)","}","","@MainActor func makeCoordinator() throws -> ScreenCoordinator {","    try get()","}"]},{"inlineContent":[{"type":"text","text":"Use "},{"code":"nonisolatedSingle","type":"codeVoice"},{"type":"text","text":", "},{"code":"nonisolatedFactory","type":"codeVoice"},{"type":"text","text":", "},{"code":"nonisolatedScoped","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"nonisolatedInstance"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"nonisolatedGet"},{"text":" for Sendable dependencies that must resolve outside MainActor. Use ","type":"text"},{"type":"codeVoice","code":"actorSingle"},{"text":", ","type":"text"},{"type":"codeVoice","code":"actorFactory"},{"text":", ","type":"text"},{"type":"codeVoice","code":"actorScoped"},{"text":", ","type":"text"},{"type":"codeVoice","code":"actorInstance"},{"text":", and async ","type":"text"},{"type":"codeVoice","code":"actorGet"},{"type":"text","text":" for an app-defined "},{"type":"codeVoice","code":"GlobalActor"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Bindings and lifetimes","role":"article","modules":[{"name":"Skein"}]},"identifier":{"url":"doc:\/\/Ske