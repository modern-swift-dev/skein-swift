{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Root registrations are either a ","type":"text"},{"code":"single","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"factory","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"scoped","type":"codeVoice"},{"text":" registration is cached once per active typed scope; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal"},{"text":".","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Binding","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Provider runs","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"single","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"At the first successful resolution","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The same instance\/value is returned for later resolutions.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"factory"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"At every resolution"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A new value is returned each time."}]}]]],"header":"row"},{"syntax":"swift","code":["import Foundation","import Skein","","final class SessionStore { }","","final class RequestID {","    let value = UUID()","}","","let module = module {","    single(SessionStore.self, using: SessionStore.init)","    factory(RequestID.self, using: RequestID.init)","}","","try startSkein { module }","","let firstStore: SessionStore = try get()","let secondStore: SessionStore = try get()","\/\/ firstStore === secondStore","","let firstID: RequestID = try g