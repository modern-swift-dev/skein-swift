{"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Skein is MainActor-first. The unprefixed ","type":"text"},{"type":"codeVoice","code":"module"},{"text":", ","type":"text"},{"type":"codeVoice","code":"single"},{"text":", ","type":"text"},{"type":"codeVoice","code":"factory"},{"text":", ","type":"text"},{"type":"codeVoice","code":"scoped"},{"text":", ","type":"text"},{"type":"codeVoice","code":"instance"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"get"},{"text":" APIs are MainActor-isolated, which makes UI-oriented, non-","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" graphs concise and compiler checked.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor final class AppPresenter { }","","let uiModule = module {","    single(AppPresenter.self, using: AppPresenter.init)","}","","@MainActor func present() throws {","    let presenter: AppPresenter = try get()","    _ = presenter","}"]},{"text":"Explicit nonisolated bindings","anchor":"Explicit-nonisolated-bindings","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"nonisolated..."},{"text":" APIs when a dependency must be resolved from concurrent code. Services, assisted arguments, dependencies, providers, and disposal callbacks must be ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SharedCache: Sendable { }","","let cacheModule = module {","    nonisolatedSingle(SharedCache.self, using: SharedCache.init)","}","","let cache: SharedCache = try application.nonisolatedGet()"]},{"type":"paragraph","inlineContent":[{"text":"A MainActor binding may depend on MainActor or nonisolated bindings. A nonisolated binding may depend only on nonisolated bindings.","type":"text"}]},{"text":"Custom global actors","anchor":"Custom-global-actors","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"App-defined global actors use asynchronous registration and resolution. The declared actor must match the provider’s compiler-retained dynamic isolation, and all values crossing the boundary are ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@globalActor actor DatabaseActor {","    static let shared = DatabaseActor()","}","","struct Database: Sendable { }","","let databaseModule = module {","    actorSingle(Database.self, isolatedTo: DatabaseActor.self, provider: {","        @DatabaseActor _ in Database()","    })","}","","let database: Database = try await application.actorGet()"]},{"type":"paragraph","inlineContent":[{"text":"Custom-actor constructor registrations may resolve Sendable dependencies across isolation domains through async ","type":"text"},{"type":"codeVoice","code":"actorGet"},{"text":". Skein does not support registrations isolated to an individual actor instance.","type":"text"}]},{"text":"Runtime guarantees and boundaries","anchor":"Runtime-guarantees-and-boundaries","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Concurrent async singleton resolution coalesces first creation; a failed creation is retried later."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cancellation of one waiter does not cancel shared singleton creation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Task-local resolution paths detect cycles across actor hops, while a container-wide wait graph detects cycles between independently started async creations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Skein protects container state but does not make registered objects internally thread-safe."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Lifetimes are lazy singleton, factory, and flat typed scope; nested scopes, reflection, property injection, and macros are not provided."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SkeinSwiftUI"},{"type":"text","text":" is the optional Apple-platform adapter."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Concurrency and isolation","modules":[{"name":"Skein"}]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","overridingTitle":"Documentation index","isActive":true}],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"seeAlsoSections":[{"anchor":"Application-composition","title":"Application composition","generated":true,"identifiers":["doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal","doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors"]}],"variants":[{"paths":["\/documentation\/skein\/concurrencyandlimitations"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Skein/documentation/Skein":{"identifier":"doc:\/\/Skein\/documentation\/Skein","abstract":[{"type":"text","text":"Skein is a small, type-safe dependency-injection container for Swift."}],"role":"collection","title":"Skein","type":"topic","kind":"symbol","url":"\/documentation\/skein"},"doc://Skein/documentation/Skein/LifecycleAndErrors":{"abstract":[{"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"type":"topic","title":"Lifecycle, validation, and er