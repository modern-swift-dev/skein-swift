{"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Skein is MainActor-first. The unprefixed "},{"type":"codeVoice","code":"module"},{"type":"text","text":", "},{"type":"codeVoice","code":"single"},{"type":"text","text":", "},{"type":"codeVoice","code":"factory"},{"type":"text","text":", "},{"type":"codeVoice","code":"scoped"},{"type":"text","text":", "},{"type":"codeVoice","code":"instance"},{"type":"text","text":", and "},{"type":"codeVoice","code":"get"},{"type":"text","text":" APIs are MainActor-isolated, which makes UI-oriented, non-"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" graphs concise and compiler checked."}]},{"syntax":"swift","code":["@MainActor final class AppPresenter { }","","let uiModule = module {","    single(AppPresenter.self, using: AppPresenter.init)","}","","@MainActor func present() throws {","    let presenter: AppPresenter = try get()","    _ = presenter","}"],"type":"codeListing"},{"anchor":"Explicit-nonisolated-bindings","type":"heading","level":2,"text":"Explicit nonisolated bindings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"nonisolated..."},{"text":" APIs when a dependency must be resolved from concurrent code. Services, assisted arguments, dependencies, providers, and disposal callbacks must be ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["struct SharedCache: Sendable { }","","let cacheModule = module {","    nonisolatedSingle(SharedCache.self, using: SharedCache.init)","}","","let cache: SharedCache = try application.nonisolatedGet()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A MainActor binding may depend on MainActor or nonisolated bindings. A nonisolated binding may depend only on nonisolated bindings."}],"type":"paragraph"},{"level":2,"text":"Custom global actors","anchor":"Custom-global-actors","type":"heading"},{"inlineContent":[{"type":"text","text":"App-defined global actors use asynchronous registration and resolution. The declared actor must match the provider’s compiler-retained dynamic isolation, and all values crossing the boundary are "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["@globalActor actor DatabaseActor {","    static let shared = DatabaseActor()","}","","struct Database: Sendable { }","","let databaseModule = module {","    actorSingle(Database.self, isolatedTo: DatabaseActor.self, provider: {","        @DatabaseActor _ in Database()","    })","}","","let database: Database = try await application.actorGet()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Custom-actor constructor registrations may resolve Sendable dependencies across isolation domains through async ","type":"text"},{"type":"codeVoice","code":"actorGet"},{"text":". Skein does not support registrations isolated to an individual actor instance.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Runtime guarantees and boundaries","anchor":"Runtime-guarantees-and-boundaries","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Concurrent async singleton resolution coalesces first creation; a failed creation is retried later."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation of one waiter does not cancel shared singleton creation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Task-local resolution paths detect cycles across actor hops, while a container-wide wait graph detects cycles between independently started async creations."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Skein protects container state but does not make registered objects internally thread-safe."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Lifetimes are lazy singleton, factory, and flat typed scope; nested scopes, reflection, property injection, and macros are not provided.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SkeinSwiftUI"},{"type":"text","text":" is the optional Apple-platform adapter."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skein\/concurrencyandlimitations"]}],"abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Concurrency and isolation","modules":[{"name":"Skein"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations"},"seeAlsoSections":[{"title":"Application composition","generated":true,"identifiers":["doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal","doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors"],"anchor":"Application-composition"}],"references":{"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","type":"topic","role":"collection","title":"Skein","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","kind":"symbol"},"doc://Skein/documentation/Skein/LifecycleAndErrors":{"title":"Lifecycle, validation, and errors","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors","abstract":[{"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"kind":"article","url":"\/documentation\/skein\/lifecycleanderrors","type":"topic"},"doc://Skein/documentation/Skein/ApplicationsAssistedFactoriesScopesAndDisposal":{"type":"topic","title":"Applications, assisted factories, scopes, and disposal","abstract":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"overridingTitle":"Documentation index","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"kind":"article","role":"article","url":"\/documentation\/skein\/applicationsassistedfactoriesscopesanddisposal","identifier":"doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal"}}}