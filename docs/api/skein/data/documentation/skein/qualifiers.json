{"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"Skein"}],"roleHeading":"Article","title":"Qualifiers"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use a qualifier when one service type has more than one intentional binding. A qualifier must conform to "},{"type":"codeVoice","code":"SkeinQualifier"},{"type":"text","text":", which requires "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". An enum is a concise, type-safe choice."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import Skein","","protocol APIEndpoint {","    var baseURL: URL { get }","}","","struct Endpoint: APIEndpoint {","    let baseURL: URL","}","","enum EndpointKind: SkeinQualifier {","    case production","    case staging","}","","let endpoints = module {","    single((any APIEndpoint).self, qualifier: EndpointKind.production, provider: { _ in","        Endpoint(baseURL: URL(string: \"https:\/\/api.example.com\")!)","    })","    single((any APIEndpoint).self, qualifier: EndpointKind.staging, provider: { _ in","        Endpoint(baseURL: URL(string: \"https:\/\/staging.example.com\")!)","    })","}","","try startSkein { endpoints }","","let production = try get(","    (any APIEndpoint).self,","    qualifier: EndpointKind.production",")"]},{"inlineContent":[{"type":"text","text":"An unqualified lookup is distinct from every qualified lookup. If only qualified bindings exist, "},{"code":"try get((any APIEndpoint).self)","type":"codeVoice"},{"text":" throws ","type":"text"},{"type":"codeVoice","code":"SkeinResolutionError"},{"type":"text","text":" whose "},{"type":"codeVoice","code":"underlying"},{"type":"text","text":" error is "},{"code":"SkeinError.missingBinding","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Qualifier identity includes both its concrete type and its value. Two different qualifier types with equal-looking cases do not collide:","type":"text"}]},{"type":"codeListing","code":["enum PrimaryEndpoint: SkeinQualifier { case active }","enum SecondaryEndpoint: SkeinQualifier { case active }"],"syntax":"swift"},{"inlineContent":[{"text":"Use the exact same qualifier type and value at registration and resolution. Each qualified ","type":"text"},{"type":"codeVoice","code":"single"},{"text":" maintains its own cached instance.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/skein\/qualifiers"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/Skein\/documentation\/Skein\/GettingStarted","doc:\/\/Skein\/documentation\/Skein\/BindingsAndLifetimes","doc:\/\/Skein\/documentation\/Skein\/ModulesAndProtocolBindings"],"anchor":"Essentials","generated":true}],"abstract":[{"type":"reference","isActive":true,"overridingTitle":"Documentation index","identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/Qualifiers","interfaceLanguage":"swift"},"references":{"doc://Skein/documentation/Skein/ModulesAndProtocolBindings":{"kind":"article","abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"overridingTitle":"Documentation index"}],"title":"Modules and protocol bindings","type":"topic","url":"\/documentation\/skein\/modulesandprotocolbindings","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/ModulesAndProtocolBindings"},"doc://Skein/documentation/Skein/Bindi