{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a qualifier when one service type has more than one intentional binding. A qualifier must conform to ","type":"text"},{"type":"codeVoice","code":"SkeinQualifier"},{"text":", which requires ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":". An enum is a concise, type-safe choice.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import Skein","","protocol APIEndpoint {","    var baseURL: URL { get }","}","","struct Endpoint: APIEndpoint {","    let baseURL: URL","}","","enum EndpointKind: SkeinQualifier {","    case production","    case staging","}","","let endpoints = module {","    single((any APIEndpoint).self, qualifier: EndpointKind.production, provider: { _ in","        Endpoint(baseURL: URL(string: \"https:\/\/api.example.com\")!)","    })","    single((any APIEndpoint).self, qualifier: EndpointKind.staging, provider: { _ in","        Endpoint(baseURL: URL(string: \"https:\/\/staging.example.com\")!)","    })","}","","try startSkein { endpoints }","","let production = try get(","    (any APIEndpoint).self,","    qualifier: EndpointKind.production",")"]},{"type":"paragraph","inlineContent":[{"text":"An unqualified lookup is distinct from every qualified lookup. If only qualified bindings exist, ","type":"text"},{"type":"codeVoice","code":"try get((any APIEndpoint).self)"},{"text":" throws ","type":"text"},{"type":"codeVoice","code":"SkeinResolutionError"},{"text":" whose ","type":"text"},{"type":"codeVoice","code":"underlying"},{"text":" error is ","type":"text"},{"type":"codeVoice","code":"SkeinError.missingBinding"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Qualifier identity includes both its concrete type and its value. Two different qualifier types with equal-looking cases do not collide:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum PrimaryEndpoint: SkeinQualifier { case active }","enum SecondaryEndpoint: SkeinQualifier { case active }"]},{"type":"paragraph","inlineContent":[{"text":"Use the exact same qualifier type and value at registration and resolution. Each qualified ","type":"text"},{"type":"codeVoice","code":"single"},{"text":" maintains its own cached instance.","type":"text"}]}]}],"abstract":[{"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","overridingTitle":"Documentation index","isActive":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"variants":[{"paths":["\/documentation\/skein\/qualifiers"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/Qualifiers","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","generated":true,"identifiers":["doc:\/\/Skein\/documentation\/Skein\/GettingStarted","doc:\/\/Skein\/documentation\/Skein\/BindingsAndLifetimes","doc:\/\/Skein\/documentation\/Skein\/ModulesAndProtocolBindings"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Qualifiers","modules":[{"name":"Skein"}]},"references":{"doc://Skein/documentation/Skein/GettingStarted":{"title":"Getting started","identifier":"doc:\/\/Skein\/documentation\/Skein\/GettingStarted","abstract":[{"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","isActive":true}],"type":"topic","role":"article","url":"\/documentation\/skein\/gettingstarted","kind":"article"},"doc://Skein/documentation/Skein/ModulesAndProtocolBindings":{"identifier":"doc:\/\/Skei