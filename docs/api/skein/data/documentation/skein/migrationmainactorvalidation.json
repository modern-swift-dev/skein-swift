n after all structural checks pass."}],"type":"paragraph"},{"code":["let uiModule = module {","    factory(AppPresenter.self, using: AppPresenter.init)","        .root(.eager)","}","","@MainActor func startDependencies() async throws {","    _ = try await startSkeinIfNeeded(validation: .declaredRoots) {","        coreModule","        uiModule","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The startup report retains opaque closure bindings as diagnostics. Eager singletons remain cached; eager factories run again on later lookup. Earlier provider side effects are not rolled back after a later failure."}],"type":"paragraph"},{"text":"Other breaking renames","level":2,"anchor":"Other-breaking-renames","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"List modules directly in application builders; arrays, optionals, branches, and loops compose naturally."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"instance(value)"},{"type":"text","text":" for supplied configuration values."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"using:"},{"type":"text","text":" for constructor injection at any arity and for assisted constructors whose runtime argument is first."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Spell closure-based assisted registrations with "},{"type":"codeVoice","code":"provider:"},{"type":"text","text":" to distinguish them from constructor packs."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"SkeinStateObject.resolving(...)"},{"type":"text","text":" or "},{"type":"codeVoice","code":".instance(model)"},{"type":"text","text":" in SwiftUI."}]}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"varian