{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"Skein"}],"title":"Getting started","role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the package to your Xcode project or Swift Package Manager manifest, then depend on its "},{"type":"codeVoice","code":"Skein"},{"type":"text","text":" product:"}],"type":"paragraph"},{"syntax":"swift","code":[".product(name: \"Skein\", package: \"skein-swift\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Define a module. A binding declares the type consumers resolve, and its provider receives a "},{"type":"codeVoice","code":"Resolver"},{"type":"text","text":" for any dependencies it needs."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import Skein","","protocol Clock {","    func now() -> Date","}","","final class SystemClock: Clock {","    func now() -> Date { Date() }","}","","final class GreetingService {","    private let clock: any Clock","","    init(clock: any Clock) {","        self.clock = clock","    }","}","","let appModule = module {","    single((any Clock).self, provider: { _ in SystemClock() })","    factory(GreetingService.self, using: GreetingService.init)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Start the global container before resolving services. Use the contextual type with "},{"type":"codeVoice","code":"get()"},{"type":"text","text":" when Swift can infer it, or supply the type explicitly."}],"type":"paragraph"},{"syntax":"swift","code":["try startSkein {","    appModule","}","","let greetingService: GreetingService = try get()","let clock = try get((any Clock).self)","","\/\/ Call during orderly application shutdown or test teardown.","stopSkein()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The unprefixed registration and resolution APIs are MainActor-isolated. "},{"type":"codeVoice","code":"get"},{"type":"text","text":", "},{"type":"codeVoice","code":"startSkein"},{"type":"text","text":", and binding providers can throw. See "},{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors","isActive":true},{"type":"text","text":" for the errors to handle."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skein\/gettingstarted"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/Skein\/documentation\/Skein\/BindingsAndLifetimes","doc:\/\/Skein\/documentation\/Skein\/ModulesAndProtocolBindings","doc:\/\/Skein\/documentation\/Skein\/Qualifiers"],"generated":true,"title":"Essentials"}],"abstract":[{"type":"reference","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/GettingStarted"},"references":{"doc://Skein/documentation/Skein/Qualifiers":{"abstract":[{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","overridingTitle":"Documentation index"}],"title":"Qualifiers","kind":"article","role":"article","type":"topic","url":"\/documentation\/skein\/qualifiers","identifier":"doc:\/\/Skein\/documentation\/Skein\/Qualifiers"},"doc://Skein/documentation/Skein/BindingsAndLifetimes":{"abstract":[{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","overridingTitle":"Documentation index"}],"title":"Bindings and lifetimes","kind":"article","role":"article","type":"topic","url