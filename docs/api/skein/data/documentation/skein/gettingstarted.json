{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the package to your Xcode project or Swift Package Manager manifest, then depend on its "},{"type":"codeVoice","code":"Skein"},{"type":"text","text":" product:"}]},{"type":"codeListing","code":[".product(name: \"Skein\", package: \"skein-swift\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define a module. A binding declares the type consumers resolve, and its provider receives a "},{"type":"codeVoice","code":"Resolver"},{"type":"text","text":" for any dependencies it needs."}]},{"type":"codeListing","code":["import Foundation","import Skein","","protocol Clock {","    func now() -> Date","}","","final class SystemClock: Clock {","    func now() -> Date { Date() }","}","","final class GreetingService {","    private let clock: any Clock","","    init(clock: any Clock) {","        self.clock = clock","    }","}","","let appModule = module {","    single((any Clock).self, provider: { _ in SystemClock() })","    factory(GreetingService.self, using: GreetingService.init)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the global container before resolving services. Use the contextual type with "},{"type":"codeVoice","code":"get()"},{"type":"text","text":" when Swift can infer it, or supply the type explicitly."}]},{"type":"codeListing","code":["try startSkein {","    appModule","}","","let greetingService: GreetingService = try get()","let clock = try get((any Clock).self)","","\/\/ Call during orderly application shutdown or test teardown.","stopSkein()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The unprefixed registration and resolution APIs are MainActor-isolated. "},{"type":"codeVoice","code":"get"},{"type":"text","text":", "},{"type":"codeVoice","code":"startSkein"},{"