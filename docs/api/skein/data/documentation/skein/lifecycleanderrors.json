{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","type":"reference"}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The global API owns one optional default application. List modules directly in its builder:"}]},{"type":"codeListing","syntax":"swift","code":["try startSkein {","    appModule","    featureModule","}","defer { stopSkein() }","","let service: FeatureService = try get()"]},{"type":"paragraph","inlineContent":[{"code":"stopSkein()","type":"codeVoice"},{"text":" detaches the application. Use ","type":"text"},{"code":"await stopSkeinAndClose()","type":"codeVoice"},{"text":" when cached values and active scopes must be disposed. ","type":"text"},{"code":"isSkeinStarted","type":"codeVoice"},{"text":" is a snapshot; ","type":"text"},{"code":"startSkeinIfNeeded","type":"codeVoice"},{"text":" atomically installs only the first candidate and does not evaluate later builders.","type":"text"}]},{"type":"heading","text":"Declared roots and validated startup","anchor":"Declared-roots-and-validated-startup","level":2},{"type":"paragraph","inlineContent":[{"text":"Attach root policy to the binding that owns it. Structural roots validate constructor metadata without executing providers. Eager roots are structurally validated first, then resolved sequentially in declaration order.","type":"text"}]},{"code":["let featureModule = module {","    single(APIClient.self, using: APIClient.init)","    factory(FeatureService.self, using: FeatureService.init)","        .root(.eager)","}","","let application = try await SkeinApplication(validation: .declaredRoots) {","    featureModule","}","print(application.startupValidationReport?.opaqueBindings ?? [])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Validated global startup is also async and publishes nothing after a validation failure:"}],"type":"paragraph"},{"code":["let installed = try await startSkeinIfNeeded(validation: .declaredRoots) {","    appModule","    featureModule","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After global publication, "},{"type":"codeVoice","code":"currentSkeinValidationReport"},{"type":"text","text":" exposes the installed application’s report under the lifecycle lock and returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" after stop."}]},{"type":"paragraph","inlineContent":[{"text":"Opaque closure providers appear in the validation report but are not failures. Constructor registrations expose all parameter-pack edges. Scoped roots and eager assisted roots are rejected; structural assisted roots are allowed.","type":"text"}]},{"anchor":"Errors-and-diagnostics","type":"heading","text":"Errors and diagnostics","level":2},{"inlineContent":[{"text":"Lifecycle failures are direct ","type":"text"},{"type":"codeVoice","code":"SkeinError"},{"text":" values. Resolution failures are ","type":"text"},{"type":"codeVoice","code":"SkeinResolutionError"},{"text":", which contains the underlying error and source-aware path frames. Invalid compositions fail with typed configuration errors. Isolation mismatches identify the required and actual binding isolation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If eager startup fails or is cancelled, initialization awaits disposal of successfully cached services before throwing. Provider side effects outside managed singleton and scope resources are not rolled back. After successful startup, eager singles remain cached; eager factories run during startup and again on later resolution."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"metadata":{"modules":[{"name":"Skein"}],"title":"Lifecycle, validation, and errors","roleHeading":"Article","role":"article"},"seeAlsoSections":[{"generated":true,"title":"Application composition","anchor":"Application-composition","identifiers":["doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal","doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skein\/lifecycleanderrors"]}],"references":{"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","type":"topic","role":"collection","title":"Skein","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","kind":"symbol"},"doc://Skein/documentation/Skein/ApplicationsAssistedFactoriesScopesAndDisposal":{"type":"topic","title":"Applications, assisted factories, scopes, and disposal","abstract":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"overridingTitle":"Documentation index","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"kind":"article","role":"article","url":"\/documentation\/skein\/applicationsassistedfactoriesscopesanddisposal","identifier":"doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal"},"doc://Skein/documentation/Skein/ConcurrencyAndLimitations":{"title":"Concurrency and isolation","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations","abstract":[{"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","type":"reference","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"kind":"article","url":"\/documentation\/skein\/concurrencyandlimitations","type":"topic"}}}