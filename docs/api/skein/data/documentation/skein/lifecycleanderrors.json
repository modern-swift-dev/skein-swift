{"variants":[{"paths":["\/documentation\/skein\/lifecycleanderrors"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","overridingTitle":"Documentation index"}],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/LifecycleAndErrors"},"metadata":{"roleHeading":"Article","modules":[{"name":"Skein"}],"role":"article","title":"Lifecycle, validation, and errors"},"seeAlsoSections":[{"generated":true,"title":"Application composition","identifiers":["doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal","doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations"],"anchor":"Application-composition"}],"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The global API owns one optional default application. List modules directly in its builder:"}]},{"code":["try startSkein {","    appModule","    featureModule","}","defer { stopSkein() }","","let service: FeatureService = try get()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopSkein()"},{"type":"text","text":" detaches the application. Use "},{"type":"codeVoice","code":"await stopSkeinAndClose()"},{"type":"text","text":" when cached values and active scopes must be disposed. "},{"type":"codeVoice","code":"isSkeinStarted"},{"type":"text","text":" is a snapshot; "},{"type":"codeVoice","code":"startSkeinIfNeeded"},{"type":"text","text":" atomically installs only the first candidate and does not evaluate later builders."}]},{"anchor":"Declared-roots-and-validated-startup","level":2,"type":"heading","text":"Declared roots and validated startup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach root policy to the binding that owns it. Structural roots validate constructor metadata without executing providers. Eager roots are structurally validated first, then resolved sequentially in declaration order."}]},{"code":["let featureModule = module {","    single(APIClient.self, using: APIClient.init)","    factory(FeatureService.self, using: FeatureService.init)","        .root(.eager)","}","","let application = try await SkeinApplication(validation: .declaredRoots) {","    featureModule","}","print(application.startupValidationReport?.opaqueBindings ?? [])"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Validated global startup is also async and publishes nothing after a validation failure:"}]},{"code":["let installed = try await startSkeinIfNeeded(validation: .declaredRoots) {","    appModule","    featureModule","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After global publication, "},{"type":"codeVoice","code":"currentSkeinValidationReport"},{"type":"text","text":" exposes the installed application’s report under the lifecycle lock and returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" after stop."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opaque closure providers appear in the validation report but are not failures. Constructor registrations expose all parameter-pack edges. Scoped roots and eager assisted roots are rejected; structural assisted roots are allowed."}]},{"anchor":"Errors-and-diagnostics","level":2,"type":"heading","text":"Errors and diagnostics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lifecycle failures are direct "},{"type":"codeVoice","code":"SkeinError"},{"type":"text","text":" values. Resolution failures are "},{"type":"codeVoice","code":"SkeinResolutionError"},{"type":"text","text":", which contains the underlying error and source-aware path frames. Invalid compositions fail with typed configuration errors. Isolation mismatches identify the required and actual binding isolation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider side effects are not rolled back if a later eager root fails. Eager singles remain cached; eager factories run during startup and again on later resolution."}]}],"kind":"content"}],"references":{"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","identifier":"doc:\/\/Skein\/documentation\/Skein","title":"Skein","role":"collection","type":"topic","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"kind":"symbol"},"doc://Skein/documentation/Skein/ApplicationsAssistedFactoriesScopesAndDisposal":{"url":"\/documentation\/skein\/applicationsassistedfactoriesscopesanddisposal","identifier":"doc:\/\/Skein\/documentation\/Skein\/ApplicationsAssistedFactoriesScopesAndDisposal","title":"Applications, assisted factories, scopes, and disposal","role":"article","type":"topic","abstract":[{"isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","overridingTitle":"Documentation index"}],"kind":"article"},"doc://Skein/documentation/Skein/ConcurrencyAndLimitations":{"url":"\/documentation\/skein\/concurrencyandlimitations","title":"Concurrency and isolation","identifier":"doc:\/\/Skein\/documentation\/Skein\/ConcurrencyAndLimitations","role":"article","type":"topic","abstract":[{"isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","type":"reference","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}]}],"kind":"article"}}}