{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use modules as a small composition root for each test. Prefer a fresh ","type":"text"},{"code":"SkeinApplication","type":"codeVoice"},{"text":" for every test: its registrations, singleton cache, scopes, and resolution state are isolated, so tests can run independently without touching global state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The global API remains useful when testing application startup, but tests that use it must serialize their full start\/resolve\/stop lifetime. A teardown alone is insufficient when the test runner executes tests concurrently."}]},{"syntax":"swift","type":"codeListing","code":["import Skein","import Foundation","import XCTest","","protocol UserAPI {","    func currentName() throws -> String","}","","final class FakeUserAPI: UserAPI {","    func currentName() throws -> String { \"Ada\" }","}","","final class WelcomeService {","    private let api: any UserAPI","","    init(api: any UserAPI) {","        self.api = api","    }","","    func message() throws -> String {","        \"Welcome, \\(try api.currentName())\"","    }","}","","@MainActor final class WelcomeServiceTests: XCTestCase {","    func testWelcomeMessage() throws {","        let testModule = module {","            single((any UserAPI).self, provider: { _ in FakeUserAPI() })","            factory(WelcomeService.self, using: WelcomeService.init)","        }","        let application = try SkeinApplication { testModule }","","        let service: WelcomeService = try application.get()","        XCTAssertEqual(try service.message(), \"Welcome, Ada\")","    }","}"]},{"inlineContent":[{"text":"Make MainActor-first tests ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"application.get","type":"codeVoice"},{"text":". For startup validation, mark bindings with ","type":"text"},{"code":".root()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".root(.eager)","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"try await SkeinApplication(validation: .declaredRoots)","type":"codeVoice"},{"text":". The retained report lists reached opaque providers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For a test that needs to inspect calls or return different values, use a manually written fake that stores the state your assertion needs. Register it as a "},{"type":"codeVoice","code":"single"},{"type":"text","text":" when the system under test and the assertion must observe the same fake instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["final class RecordingUserAPI: UserAPI {","    private(set) var calls = 0","","    func currentName() throws -> String {","        calls += 1","        return \"Ada\"","    }","}"]},{"inlineContent":[{"text":"The package does not currently provide a testing framework integration or automatic mock generation. Manual doubles keep the test setup within the existing Skein API.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skein\/testing"]}],"abstract":[{"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true,"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}]}],"metadata":{"modules":[{"name":"Skein"}],"role":"article","roleHeading":"Article","title":"Testing with manual doubles"},"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"url":"doc:\/\/Skein\/documentation\/Skein\/Testing","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Development","anchor":"Development","identifiers":["doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation"],"generated":true}],"references":{"doc://Skein/documentation/Skein/MigrationMainActorValidation":{"abstract":[{"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index"}],"url":"\/documentation\/skein\/migrationmainactorvalidation","type":"topic","title":"MainActor-first and validation migration","kind":"article","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation"},"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","type":"topic","role":"collection","title":"Skein","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","kind":"symbol"}}}