{"metadata":{"modules":[{"name":"Skein"}],"title":"Testing with manual doubles","role":"article","roleHeading":"Article"},"sections":[],"abstract":[{"type":"reference","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use modules as a small composition root for each test. Prefer a fresh "},{"type":"codeVoice","code":"SkeinApplication"},{"type":"text","text":" for every test: its registrations, singleton cache, scopes, and resolution state are isolated, so tests can run independently without touching global state."}]},{"type":"paragraph","inlineContent":[{"text":"The global API remains useful when testing application startup, but tests that use it must serialize their full start\/resolve\/stop lifetime. A teardown alone is insufficient when the test runner executes tests concurrently.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Skein","import Foundation","import XCTest","","protocol UserAPI {","    func currentName() throws -> String","}","","final class FakeUserAPI: UserAPI {","    func currentName() throws -> String { \"Ada\" }","}","","final class WelcomeService {","    private let api: any UserAPI","","    init(api: any UserAPI) {","        self.api = api","    }","","    func message() throws -> String {","        \"Welcome, \\(try api.currentName())\"","    }","}","","@MainActor final class WelcomeServiceTests: XCTestCase {","    func testWelcomeMessage() throws {","        let testModule = module {","            single((any UserAPI).self, provider: { _ in FakeUserAPI() })","            factory(WelcomeService.self, using: WelcomeService.init)","        }","        let application = try SkeinApplication { testModule }","","        let service: WelcomeService = try application.get()","        XCTAssertEqual(try service.message(), \"Welcome, Ada\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Make MainActor-first tests ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"application.get","type":"codeVoice"},{"text":". For startup validation, mark bindings with ","type":"text"},{"code":".root()","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".root(.eager)","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"try await SkeinApplication(validation: .declaredRoots)","type":"codeVoice"},{"text":". The retained report lists reached opaque providers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For a test that needs to inspect calls or return different values, use a manually written fake that stores the state your assertion needs. Register it as a ","type":"text"},{"code":"single","type":"codeVoice"},{"text":" when the system under test and the assertion must observe the same fake instance.","type":"text"}]},{"code":["final class RecordingUserAPI: UserAPI {","    private(set) var calls = 0","","    func currentName() throws -> String {","        calls += 1","        return \"Ada\"","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The package does not currently provide a testing framework integration or automatic mock generation. Manual doubles keep the test setup within the existing Skein API."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/skein\/testing"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/Testing"},"seeAlsoSections":[{"anchor":"Development","identifiers":["doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation"],"generated":true,"title":"Development"}],"kind":"article","references":{"doc://Skein/documentation/Skein/MigrationMainActorValidation":{"abstract":[{"type":"reference","overridingTitle":"Documentation index","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"identifier":"doc:\/\/Skein\/documentation\/Skein"}],"type":"topic","title":"MainActor-first and validation migration","identifier":"doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation","url":"\/documentation\/skein\/migrationmainactorvalidation","role":"article","kind":"article"},"doc://Skein/documentation/Skein":{"abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"type":"topic","title":"Skein","identifier":"doc:\/\/Skein\/documentation\/Skein","url":"\/documentation\/skein","role":"collection","kind":"symbol"}}}