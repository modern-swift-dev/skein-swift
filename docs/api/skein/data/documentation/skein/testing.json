{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/Testing"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use modules as a small composition root for each test. Prefer a fresh "},{"type":"codeVoice","code":"SkeinApplication"},{"type":"text","text":" for every test: its registrations, singleton cache, scopes, and resolution state are isolated, so tests can run independently without touching global state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The global API remains useful when testing application startup, but tests that use it must serialize their full start\/resolve\/stop lifetime. A teardown alone is insufficient when the test runner executes tests concurrently."}]},{"syntax":"swift","type":"codeListing","code":["import Skein","import Foundation","import XCTest","","protocol UserAPI {","    func currentName() throws -> String","}","","final class FakeUserAPI: UserAPI {","    func currentName() throws -> String { \"Ada\" }","}","","final class WelcomeService {","    private let api: any UserAPI","","    init(api: any UserAPI) {","        self.api = api","    }","","    func message() throws -> String {","        \"Welcome, \\(try api.currentName())\"","    }","}","","@MainActor final class WelcomeServiceTests: XCTestCase {","    func testWelcomeMessage() throws {","        let testModule = module {","            single((any UserAPI).self, provider: { _ in FakeUserAPI() })","            factory(WelcomeService.self, using: WelcomeService.init)","        }","        let application = try SkeinApplication { testModule }","","        let service: WelcomeService = try application.get()","        XCTAssertEqual(try service.message(), \"Welcome, Ada\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make MainActor-first tests "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"application.get"},{"type":"text","text":". For startup validation, mark bindings with "},{"type":"codeVoice","code":".root()"},{"type":"text","text":" or "},{"type":"codeVoice","code":".root(.eager)"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"try await SkeinApplication(validation: .declaredRoots)"},{"type":"text","text":". The retained report lists reached opaque providers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a test that needs to inspect calls or return different values, use a manually written fake that stores the state your assertion needs. Register it as a "},{"type":"codeVoice","code":"single"},{"type":"text","text":" when the system under test and the assertion must observe the same fake instance."}]},{"syntax":"swift","type":"codeListing","code":["final class RecordingUserAPI: UserAPI {","    private(set) var calls = 0","","    func currentName() throws -> String {","        calls += 1","        return \"Ada\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package does not currently provide a testing framework integration or automatic mock generation. Manual doubles keep the test setup within the existing Skein API."}]}]}],"metadata":{"role":"article","modules":[{"name":"Skein"}],"title":"Testing with manual doubles","roleHeading":"Article"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","isActive":true,"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation"],"anchor":"Development","title":"Development"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skein\/testing"]}],"references":{"doc://Skein/documentation/Skein/MigrationMainActorValidation":{"abstract":[{"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"type":"reference","identifier":"doc:\/\/Skein\/documentation\/Skein","isActive":true}],"type":"topic","title":"MainActor-first and validation migration","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation","url":"\/documentation\/skein\/migrationmainactorvalidation","kind":"article"},"doc://Skein/documentation/Skein":{"identifier":"doc:\/\/Skein\/documentation\/Skein","abstract":[{"type":"text","text":"Skein is a small, type-safe dependency-injection container for Swift."}],"role":"collection","title":"Skein","type":"topic","kind":"symbol","url":"\/documentation\/skein"}}}