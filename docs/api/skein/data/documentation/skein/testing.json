{"hierarchy":{"paths":[["doc:\/\/Skein\/documentation\/Skein"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Skein\/documentation\/Skein\/Testing"},"seeAlsoSections":[{"identifiers":["doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation"],"title":"Development","anchor":"Development","generated":true}],"primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use modules as a small composition root for each test. Prefer a fresh ","type":"text"},{"code":"SkeinApplication","type":"codeVoice"},{"type":"text","text":" for every test: its registrations, singleton cache, scopes, and resolution state are isolated, so tests can run independently without touching global state."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The global API remains useful when testing application startup, but tests that use it must serialize their full start\/resolve\/stop lifetime. A teardown alone is insufficient when the test runner executes tests concurrently.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Skein","import Foundation","import XCTest","","protocol UserAPI {","    func currentName() throws -> String","}","","final class FakeUserAPI: UserAPI {","    func currentName() throws -> String { \"Ada\" }","}","","final class WelcomeService {","    private let api: any UserAPI","","    init(api: any UserAPI) {","        self.api = api","    }","","    func message() throws -> String {","        \"Welcome, \\(try api.currentName())\"","    }","}","","@MainActor final class WelcomeServiceTests: XCTestCase {","    func testWelcomeMessage() throws {","        let testModule = module {","            single((any UserAPI).self, provider: { _ in FakeUserAPI() })","            factory(WelcomeService.self, using: WelcomeService.init)","        }","        let application = try SkeinApplication { testModule }","","        let service: WelcomeService = try application.get()","        XCTAssertEqual(try service.message(), \"Welcome, Ada\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Make MainActor-first tests "},{"type":"codeVoice","code":"@MainActor"},{"text":" and use ","type":"text"},{"code":"application.get","type":"codeVoice"},{"text":". For startup validation, mark bindings with ","type":"text"},{"type":"codeVoice","code":".root()"},{"type":"text","text":" or "},{"type":"codeVoice","code":".root(.eager)"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"try await SkeinApplication(validation: .declaredRoots)"},{"type":"text","text":". The retained report lists reached opaque providers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a test that needs to inspect calls or return different values, use a manually written fake that stores the state your assertion needs. Register it as a "},{"type":"codeVoice","code":"single"},{"type":"text","text":" when the system under test and the assertion must observe the same fake instance."}]},{"type":"codeListing","syntax":"swift","code":["final class RecordingUserAPI: UserAPI {","    private(set) var calls = 0","","    func currentName() throws -> String {","        calls += 1","        return \"Ada\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package does not currently provide a testing framework integration or automatic mock generation. Manual doubles keep the test setup within the existing Skein API."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/skein\/testing"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"Skein"}],"role":"article","title":"Testing with manual doubles"},"sections":[],"abstract":[{"identifier":"doc:\/\/Skein\/documentation\/Skein","type":"reference","isActive":true,"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"kind":"article","references":{"doc://Skein/documentation/Skein":{"url":"\/documentation\/skein","identifier":"doc:\/\/Skein\/documentation\/Skein","title":"Skein","role":"collection","type":"topic","abstract":[{"text":"Skein is a small, type-safe dependency-injection container for Swift.","type":"text"}],"kind":"symbol"},"doc://Skein/documentation/Skein/MigrationMainActorValidation":{"type":"topic","title":"MainActor-first and validation migration","abstract":[{"isActive":true,"identifier":"doc:\/\/Skein\/documentation\/Skein","overridingTitle":"Documentation index","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"kind":"article","role":"article","identifier":"doc:\/\/Skein\/documentation\/Skein\/MigrationMainActorValidation","url":"\/documentation\/skein\/migrationmainactorvalidation"}}}